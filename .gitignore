# Dependencies (reinstalled with `npm install`)
node_modules/

# Build output (recreated with `npm run build`)
dist/
dist-ssr/

# Environment variables, secrets and credentials — never commit these
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
*.crt
.npmrc
secrets/
credentials*.json
service-account*.json

# Logs and caches
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.cache/
.eslintcache
coverage/

# Hosting tool folders (created locally by deploy CLIs)
.vercel/
.netlify/
.firebase/

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
