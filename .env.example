# Copy to .env.local for local development (never commit real .env files).
#
# Public URL of the Cloudflare Worker in /cloudflare-worker that generates designs for
# "DESIGN WITH RENA HOME", e.g. https://rena-home-design-api.<account>.workers.dev
# This is NOT a secret (it is visible in the website). No API token is needed anywhere:
# the Worker uses the Workers AI binding. Never put tokens or keys in a VITE_ variable.
# Leave empty to keep AI generation switched off (the page then shows "coming soon").
VITE_DESIGN_API_URL=
